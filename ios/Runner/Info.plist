<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Presensi SMK</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>presensi_smkn1_beringin</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- External URL schemes for url_launcher (Maps, Browser, WhatsApp) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>comgooglemaps</string>
		<string>maps</string>
		<string>whatsapp</string>
	</array>

	<!-- Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>Aplikasi presensi memerlukan kamera untuk pemindaian dan verifikasi biometrik wajah siswa.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Aplikasi memerlukan akses galeri foto agar Anda dapat memilih foto profil dan banner siswa.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Aplikasi memerlukan izin galeri untuk menyimpan gambar bila diperlukan.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Aplikasi memerlukan GPS untuk memastikan Anda berada di dalam radius geofencing SMK Negeri 1 Beringin saat presensi.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Aplikasi memerlukan GPS untuk memvalidasi posisi Anda di SMK Negeri 1 Beringin.</string>
</dict>
</plist>
